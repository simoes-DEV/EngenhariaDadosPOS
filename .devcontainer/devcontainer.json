{
  "name": "Pós Engenharia de Dados (Tablet & Casa)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && chmod +x .devcontainer/auto-sync.sh",
  "postStartCommand": "nohup bash .devcontainer/auto-sync.sh >/tmp/auto-sync.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "mechatroner.rainbow-csv",
        "qwtel.sqlite-viewer"
      ],
      "settings": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "git.autofetch": "all",
        "git.autofetchPeriod": 60,
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "git.postCommitCommand": "push"
      }
    }
  }
}
